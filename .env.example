# ── AI ──────────────────────────────────────────────
# Key Gemini buat generate materi/soal/cek. Wajib.
GEMINI_API_KEY=
# Fallback kalau Gemini kena limit (opsional).
GROQ_API_KEY=
# Batas panggilan AI per guru per bulan (gratis / madrasah berpaket aktif).
AI_MONTHLY_LIMIT=100
AI_MONTHLY_LIMIT_PAID=1000

# ── Paket madrasah ──────────────────────────────────
# Email Google yang boleh buka /admin buat aktifin paket (pisah koma).
SUPERADMIN_EMAILS=
# Nomor WA buat madrasah yang mau beli paket, format 628xxx (tampil di halaman Madrasah).
CONTACT_WA=

# ── Database (Neon Postgres) ────────────────────────
# Ambil dari dashboard Neon → Connection string (pooled).
DATABASE_URL=

# ── Auth (Google SSO) ───────────────────────────────
# Buat OAuth app di Google Cloud Console → Credentials → OAuth client (Web).
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Password acak min 32 karakter buat enkripsi cookie sesi.
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
