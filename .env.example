# ── AI ──────────────────────────────────────────────
# Key Gemini buat generate materi/soal/cek. Wajib.
GEMINI_API_KEY=
# Fallback kalau Gemini kena limit (opsional).
GROQ_API_KEY=

# ── Database (Neon Postgres) ────────────────────────
# Ambil dari dashboard Neon → Connection string (pooled).
DATABASE_URL=

# ── Auth (Google SSO) ───────────────────────────────
# Buat OAuth app di Google Cloud Console → Credentials → OAuth client (Web).
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Password acak min 32 karakter buat enkripsi cookie sesi.
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
